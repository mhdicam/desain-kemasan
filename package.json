{
  "name": "openbox3d",
  "version": "0.1.0",
  "description": "AstaKraf Studio Kemasan — Studio desain kemasan berbasis browser: dieline parametrik, desain berlapis, pratinjau lipat 3D PBR, dan ekspor PDF cetak",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yuyou-dev/OpenBox3D.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "npm run check:template-sync && npm run check:model-foundation && npm run check:reference-assets",
    "build": "vite build",
    "build:pages": "npm run check:template-sync && vite build --base=/",
    "check:template-sync": "node scripts/check-template-sync.mjs",
    "preset:from": "node scripts/boxproj-to-preset.mjs",
    "preview": "vite preview",
    "check:model-foundation": "node --test tests/model-foundation.test.mjs",
    "check:reference-assets": "node --test tests/can-label-reference.test.mjs"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "three": "0.184.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^5.4.11"
  }
}
